{
  "name": "aoi-workspace",
  "private": true,
  "description": "AOI Agentic Operational Infrastructure Runtime",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:dashboard": "pnpm --filter agentic-ops-dashboard dev",
    "build:dashboard": "pnpm --filter agentic-ops-dashboard build",
    "preview:dashboard": "pnpm --filter agentic-ops-dashboard preview",
    "test:dashboard": "pnpm --filter agentic-ops-dashboard test",
    "prepare:dashboard": "pnpm --filter agentic-ops-dashboard exec nuxt prepare",
    "test:memory-sync": "node --test scripts/memory-sync/*.test.mjs",
    "test:memory-sync:bundle": "node --test scripts/memory-sync/bundle-contract.test.mjs scripts/memory-sync/export-memory-bundle.test.mjs scripts/memory-sync/import-memory-bundle.test.mjs scripts/memory-sync/bundle-lifecycle.test.mjs",
    "test:subagent-payload": "node --test scripts/subagent-context/*.test.mjs",
    "test:sdd-lifecycle": "node --test scripts/sdd-lifecycle/*.test.mjs",
    "test:spatiotemporal": "node --test scripts/spatiotemporal-runtime/*.test.mjs",
    "test:mcp-gateway": "node --test scripts/mcp-gateway/*.test.mjs",
    "doctor": "node scripts/aoi-doctor.mjs",
    "aoi:doctor": "node scripts/aoi-doctor.mjs",
    "test:doctor": "node --test scripts/aoi-doctor.test.mjs",
    "test:parity": "node scripts/scaffold/validate-scaffold-parity.mjs && node --test scripts/scaffold/*.test.mjs",
    "test": "pnpm test:parity && pnpm test:doctor && pnpm test:memory-sync && pnpm test:memory-sync:bundle && pnpm test:subagent-payload && pnpm test:sdd-lifecycle && pnpm test:spatiotemporal && pnpm test:mcp-gateway && pnpm test:dashboard"
  }
}